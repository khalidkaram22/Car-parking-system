<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:padding="8dp"
    tools:context=".LoginFragment">


    <TextView
        android:id="@+id/login_textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="28dp"
        android:layout_marginTop="64dp"
        android:text="Login"
        android:textColor="@color/general_blue"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="MissingConstraints" />


    <Button
        android:id="@+id/login_as_user"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:text="Login as User !"
        android:textColor="@android:color/white"
        app:backgroundTint="@color/general_blue"
        app:layout_constraintTop_toTopOf="@+id/login_textView"
        app:layout_constraintEnd_toEndOf="parent"
        tools:ignore="MissingConstraints" />

    <TextView
        android:id="@+id/login_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/admin_Login_header"
        android:textColor="@color/general_blue"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="@+id/login_textView"
        app:layout_constraintTop_toBottomOf="@+id/login_textView" />

    <ImageView
        android:id="@+id/login_person_ic"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_margin="24dp"
        android:src="@drawable/person_ic"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/login_header"
        app:tint="@color/dark_blue" />

    <EditText
        android:id="@+id/login_email_et"
        style="@style/edit_text_signup"
        android:background="@drawable/edittext_background"
        android:hint="Enter your email"
        android:inputType="textEmailAddress"
        android:textColorHint="@color/general_blue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/login_person_ic" />

    <EditText
        android:id="@+id/login_password_et"
        style="@style/edit_text_signup"
        android:background="@drawable/edittext_background"
        android:hint="password"
        android:inputType="textPassword"
        android:textColorHint="@color/general_blue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/login_email_et" />


    <Button
        android:id="@+id/register_btn"
        style="@style/button_style_2"
        android:background="@drawable/button_background"
        android:text="Register"
        android:textColor="@android:color/white"
        app:backgroundTint="@color/general_blue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/login_password_et" />


    <CheckBox
        android:id="@+id/rememberme_cb"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:text="remember"
        android:textColor="@color/general_blue"
        android:buttonTint="@color/general_blue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/register_btn" />





</androidx.constraintlayout.widget.ConstraintLayout>