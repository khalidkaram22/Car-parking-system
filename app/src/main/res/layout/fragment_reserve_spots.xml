<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:padding="8dp"
    tools:context=".ReserveSpotsFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:padding="8dp"
        >


        <ImageView
            android:id="@+id/back_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:src="@drawable/ic_back"
            app:tint="@color/general_blue"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="MissingConstraints" />

<!--    <ImageView-->
<!--        android:id="@+id/reserve_imageView"-->
<!--        android:layout_width="300dp"-->
<!--        android:layout_height="150dp"-->
<!--        android:layout_marginTop="48dp"-->
<!--        android:background="@drawable/rounded_image"-->
<!--        android:clipToOutline="true"-->
<!--        android:scaleType="centerCrop"-->
<!--        android:src="@drawable/undraw_city_driver_re_9xyv"-->
<!--        app:layout_constraintEnd_toEndOf="parent"-->
<!--        app:layout_constraintStart_toStartOf="parent"-->
<!--        app:layout_constraintTop_toTopOf="parent" />-->

    <!-- Title -->
        <TextView
            android:id="@+id/reserve_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:text="Reserve a spot"
            android:textColor="@color/general_blue"
            android:textSize="32sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    <!-- From now to time selection -->
    <TextView
        android:id="@+id/from_now_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="32dp"
        android:text="from now to:"
        android:textColor="@color/dark_blue"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/reserve_header" />

    <TextView
        android:id="@+id/end_time_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/rounded_image"
        android:inputType="datetime"
        android:padding="8dp"
        android:text="00:00:00"
        android:textColor="@color/light_blue"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="@+id/from_now_label"
        app:layout_constraintStart_toEndOf="@+id/from_now_label"
        app:layout_constraintTop_toTopOf="@+id/from_now_label" />

        <ImageView
            android:id="@+id/drop_up_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/arrow_drop_up_ic"
            app:layout_constraintStart_toEndOf="@+id/end_time_tv"
            app:layout_constraintTop_toTopOf="@+id/end_time_tv"
            app:layout_constraintBottom_toTopOf="@+id/drop_dwon_btn"
            tools:layout_editor_absoluteY="8dp" />

        <ImageView
            android:id="@+id/drop_dwon_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/arrow_drop_down_ic"
            app:layout_constraintStart_toEndOf="@+id/end_time_tv"
            app:layout_constraintBottom_toBottomOf="@+id/end_time_tv"
            app:layout_constraintTop_toBottomOf="@+id/drop_up_btn"
            tools:layout_editor_absoluteY="8dp" />


    <!-- Rate and number of hours -->
<!--    <RadioGroup-->
<!--        android:id="@+id/time_rg"-->
<!--        android:layout_width="wrap_content"-->
<!--        android:layout_height="wrap_content"-->
<!--        android:orientation="horizontal"-->
<!--        app:layout_constraintBottom_toBottomOf="@+id/end_time_tv"-->
<!--        app:layout_constraintStart_toEndOf="@+id/drop_dwon_btn"-->
<!--        app:layout_constraintTop_toTopOf="@+id/end_time_tv"-->
<!--        tools:ignore="MissingConstraints">-->

<!--        <RadioButton-->
<!--            android:id="@+id/am_rg"-->
<!--            android:layout_width="wrap_content"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:text="AM" />-->

<!--        <RadioButton-->
<!--            android:id="@+id/pm_rg"-->
<!--            android:layout_width="wrap_content"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:checked="true"-->
<!--            android:text="PM" />-->
<!--    </RadioGroup>-->


    <!-- Rate and number of hours -->
    <TextView
        android:id="@+id/rate_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="16dp"
        android:text="rate/hr "
        android:textColor="@color/dark_blue"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/end_time_tv" />

    <TextView
        android:id="@+id/hours_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="32dp"
        android:text="n of hrs"
        android:textColor="@color/dark_blue"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/end_time_tv" />

    <TextView
        android:id="@+id/rate_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="16dp"
        android:text="10 EGP"
        android:textColor="@color/general_blue"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rate_label" />

    <TextView
        android:id="@+id/num_of_hours"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="32dp"
        android:text="3"
        android:textColor="@color/general_blue"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/rate_value"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/rate_value" />


    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter your car plate Number :"
        android:layout_marginTop="16dp"
        android:textColor="@color/dark_blue"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@+id/rate_value"
        app:layout_constraintTop_toBottomOf="@+id/rate_value" />


        <EditText
            android:id="@+id/plate_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="12dp"
            android:background="@drawable/edittext_background"
            android:hint=" 1 2 3 "
            android:inputType="number"
            android:textSize="16sp"
            app:layout_constraintStart_toStartOf="@+id/textView2"
            app:layout_constraintTop_toBottomOf="@+id/textView2" />

        <EditText
            android:id="@+id/plate_char"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="30dp"
            android:layout_marginVertical="12dp"
            android:background="@drawable/edittext_background"
            android:hint="  أ س د"
            android:inputType="textPersonName"
            android:digits="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZأبجدھوزحطيكلمنسعفصقرشتثخذضظغ"
            android:textSize="16sp"
            app:layout_constraintStart_toEndOf="@+id/plate_num"
            app:layout_constraintTop_toBottomOf="@+id/textView2" />

    <!-- Divider -->
    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="16dp"
        android:background="@color/dark_blue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/plate_num" />

    <!-- Total label and value -->
    <TextView
        android:id="@+id/total_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="32dp"
        android:text="Total:"
        android:textColor="@color/dark_blue"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/divider" />

    <TextView
        android:id="@+id/total_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="32dp"
        android:text="0EGP"
        android:textColor="@color/general_blue"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintTop_toTopOf="@+id/total_label" />

    <!-- Proceed to payment button -->
    <Button
        android:id="@+id/proceed_topayment_btn"
        style="@style/button_style"
        android:layout_marginTop="16dp"
        android:background="@drawable/button_background"
        app:backgroundTint="@color/general_blue"
        android:text="proceed to payment"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/total_value" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>