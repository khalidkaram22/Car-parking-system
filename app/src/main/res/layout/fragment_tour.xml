<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".TourFragment">


    <ImageView
        android:id="@+id/tour_img"
        android:layout_width="wrap_content"
        android:layout_height="350dp"
        android:clipToOutline="true"
        android:src="@drawable/getstart_1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tour_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text=" Welcome to our app "
        android:textColor="@color/general_blue"
        android:textSize="32sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tour_img"
        tools:ignore="MissingConstraints" />

    <TextView
        android:id="@+id/tour_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/tour_1_text"
        android:textAlignment="center"
        android:textColor="@color/gray_text_color"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tour_header"
        tools:ignore="MissingConstraints" />

    <View
        android:id="@+id/index_1"
        android:layout_width="25dp"
        android:layout_height="7dp"
        android:layout_margin="4dp"
        android:background="@drawable/small_index"
        android:backgroundTint="@color/general_blue"
        app:layout_constraintTop_toBottomOf="@+id/tour_text"
        app:layout_constraintBottom_toTopOf="@+id/nxt_btn"
       app:layout_constraintEnd_toStartOf="@id/index_2"
        />

    <View
        android:id="@+id/index_2"
        android:layout_width="24dp"
        android:layout_height="8dp"
        android:layout_margin="4dp"
        android:background="@drawable/small_index"
        app:backgroundTint="@color/gray_text_color"
        app:layout_constraintBottom_toTopOf="@+id/nxt_btn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tour_text"
        tools:ignore="MissingConstraints" />

    <View
        android:id="@+id/index_3"
        android:layout_width="24dp"
        android:layout_height="8dp"
        android:layout_margin="4dp"
        android:background="@drawable/small_index"
        app:layout_constraintBottom_toTopOf="@+id/nxt_btn"
        app:layout_constraintStart_toEndOf="@+id/index_2"
        app:layout_constraintTop_toBottomOf="@+id/tour_text" />

    <Button
        android:id="@+id/nxt_btn"
        style="@style/button_style_2"
        android:background="@drawable/button_background"
        android:text="Next"
        android:textSize="16sp"
        android:textColor="@color/white"
        app:backgroundTint="@color/general_blue"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tour_text" />

<!--    <Button-->
<!--        android:id="@+id/prev_btn"-->
<!--        android:layout_width="140dp"-->
<!--        android:layout_height="wrap_content"-->
<!--        android:layout_marginBottom="16dp"-->
<!--        android:background="@drawable/button_background"-->
<!--        android:padding="8dp"-->
<!--        android:text="Back"-->
<!--        android:textSize="20sp"-->
<!--        app:backgroundTint="@color/general_blue"-->
<!--        app:layout_constraintBottom_toBottomOf="parent"-->
<!--        app:layout_constraintStart_toStartOf="@+id/nxt_btn"-->
<!--        app:layout_constraintTop_toBottomOf="@+id/nxt_btn" />-->

    <TextView
        android:id="@+id/skip_btn"
        android:layout_width="140dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Skip"
        android:textColor="@color/gray_skip"
        android:textAlignment="center"
        android:textSize="20sp"
        app:backgroundTint="@color/general_blue"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/nxt_btn"
        app:layout_constraintEnd_toEndOf="@id/nxt_btn"
        app:layout_constraintTop_toBottomOf="@+id/nxt_btn" />


</androidx.constraintlayout.widget.ConstraintLayout>