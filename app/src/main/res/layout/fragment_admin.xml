    <TextView
        android:id="@+id/admin_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="72dp"
        android:text="@string/admin_header"
        android:textColor="@color/general_blue"
        android:textStyle="bold"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />

    <Switch
        android:id="@+id/entry_gate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="32dp"
        android:text="Switch entry Gate"
        android:checked="true"
        android:textSize="20sp"
        app:layout_constraintTop_toBottomOf="@id/admin_header"
        tools:ignore="UseSwitchCompatOrMaterialXml" />

    <Switch
        android:id="@+id/exit_gate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="32dp"
        android:text="Exit Gate"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="@id/entry_gate"
        app:layout_constraintTop_toBottomOf="@id/entry_gate"
        tools:ignore="UseSwitchCompatOrMaterialXml" />

    <Switch
        android:id="@+id/switch3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="32dp"
        android:text="Gate open/closed"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="@id/entry_gate"
        app:layout_constraintTop_toBottomOf="@id/exit_gate"
        tools:ignore="HardcodedText,UseSwitchCompatOrMaterialXml" />

</androidx.constraintlayout.widget.ConstraintLayout>
