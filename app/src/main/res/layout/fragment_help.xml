<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:padding="24dp"
    tools:context=".HelpFragment">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="vertical">


        <ImageView
            android:id="@+id/back_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:src="@drawable/ic_back"
            app:tint="@color/general_blue"
            tools:ignore="MissingConstraints" />


        <TextView
            android:id="@+id/helpTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:paddingBottom="16dp"
            android:text="How to Use the App"
            android:textColor="@color/general_blue"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Help Content -->
        <!-- Step 1 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="✅ Step 1: Register or Log In\nCreate an account or sign in with your email."
            android:textColor="@color/black"
            android:textSize="16sp" />

        <!-- Step 2 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="✅ Step 2: Add Your Car\nEnter your car plate number ( like: 123 | أ ب ج)."
            android:textColor="@color/black"
            android:textSize="16sp" />

        <!-- Step 3 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="✅ Step 3: Reserve a Slot\nChoose the time and date you want to park."
            android:textColor="@color/black"
            android:textSize="16sp" />

        <!-- Step 4 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="✅ Step 4: Start Parking\nStart your parking session once you pay and reserve the slot."
            android:textColor="@color/black"
            android:textSize="16sp"
            tools:ignore="HardcodedText" />

        <!-- Step 5 -->
<!--        <TextView-->
<!--            android:layout_width="match_parent"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:layout_marginBottom="16dp"-->
<!--            android:text="✅ Step 5: Manage Reservation\nYou can edit, extend, or cancel your reservation anytime."-->
<!--            android:textColor="@color/black"-->
<!--            android:textSize="16sp"-->
<!--            tools:ignore="HardcodedText" />-->

        <!-- Step 6 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:text="✅ Step 5: Track and Pay\nTrack your parking time and pay securely through the app."
            android:textColor="@color/black"
            android:textSize="16sp"
            tools:ignore="HardcodedText" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="24dp"
            android:background="@color/general_blue"
            tools:ignore="HardcodedText" />

        <!-- About Us Title -->
        <TextView
            android:id="@+id/aboutUsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingBottom="16dp"
            android:text="About Us"
            android:textColor="@color/general_blue"
            android:textSize="24sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />

        <!-- About Us Content -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:background="@color/white"
                android:text="We are a passionate team dedicated to making parking easier and smarter for everyone.\n\n🚗 Find available slots easily.\n💳 Pay directly in the app.\n🔒 Safe, secure, and fast service.\n\nThank you for choosing us!"
                android:textColor="@color/black"
                android:textSize="16sp" />
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/contactUsButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/general_blue"
            android:text="Contact Us"
            android:textColor="@android:color/white" />


    </LinearLayout>

</ScrollView>
