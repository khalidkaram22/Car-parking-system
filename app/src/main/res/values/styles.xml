<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="edit_text_signup">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginHorizontal">28dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColorHint">@color/light_blue</item>
        <item name="android:layout_marginTop">24dp</item>
    </style>

    <style name="CustomButtonStyle">
        <item name="android:background">@drawable/button_background</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginHorizontal">32dp</item>
        <item name="android:padding">10dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:backgroundTint">@color/button_color</item>
    </style>



    <style name="button_style2">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginHorizontal">32dp</item>
        <item name="android:padding">10dp</item>
        <item name="android:layout_marginTop">16dp</item>
    </style>


    <style name="button_style_2">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginHorizontal">28dp</item>
        <item name="android:padding">10dp</item>
        <item name="android:layout_marginVertical">16dp</item>
    </style>


    <style name="button_style">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginHorizontal">32dp</item>
        <item name="android:padding">8dp</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:backgroundTint">@color/button_color</item>
    </style>


    <style name="CircleImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
        <item name="backgroundColor">@color/cardview_light_background</item>
    </style>

    <!-- Style for EditText -->
    <style name="CustomEditTextStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:layout_marginHorizontal">48dp</item>
        <item name="android:textSize">16sp</item>
<!--        <item name="android:background">@drawable/edit_text_style</item>-->
<!--        <item name="android:textColorHint">@color/font_mental</item>-->
    </style>



    <!-- Style for TextView -->
    <style name="small_text_btn">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">18sp</item>

    </style>

</resources>