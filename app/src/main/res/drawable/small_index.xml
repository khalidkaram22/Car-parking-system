<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_enabled="true">
        <shape>
            <solid android:color="#C9D2EB" /> <!-- Background color -->

            <corners android:radius="4dp" /> <!-- Rounded corners -->

            <padding
                android:left="12dp"
                android:top="24dp"
                android:right="12dp"
                android:bottom="24dp" /> <!-- Inner padding -->

        </shape>
    </item>

</selector>
